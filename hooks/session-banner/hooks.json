{
  "name": "session-banner",
  "description": "SessionStart hook that prints a one-line agent + project banner so you always know which window is which.",
  "version": 1,
  "files": ["scripts/banner.mjs"],
  "hooks": [
    {
      "id": "print-banner",
      "command": "node $HOOK_DIR/scripts/banner.mjs",
      "harnesses": {
        "claude-code": { "event": "SessionStart" },
        "codex": {
          "event": "SessionStart",
          "matcher": "startup|resume",
          "command": "MYHOOKS_BANNER_AGENT=codex node $HOOK_DIR/scripts/banner.mjs"
        }
      }
    }
  ]
}
